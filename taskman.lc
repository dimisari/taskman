COMMENT
types

TUPLE TYPE
Task = String x Tasks
(desc, subtasks)

TYPE NICKNAME
Tasks = ListOf(Task)s

TYPE NICKNAME
Path = String

TYPE NICKNAME
Line = String

TYPE NICKNAME
Lines = ListOf(Line)s

TYPE NICKNAME
Strings = ListOf(String)s

TYPE NICKNAME
Programs = ListOf(Program)s

TYPE NICKNAME
Location = TaskPath x Path

TYPE NICKNAME
TaskPath = ListOf(Int)s

COMMENT
main

main : Program
  = choose_task_category

choose_task_category : Program
  = say(to_say)and_list_choices_from(category_choices) ;
    choose_from(category_programs)
    where
    to_say : String
      = "Choose task category to show by number"

choose_from(_) : Programs => Program
  = programs =>
    get_line >> ?
      "" => do_nothing
      l => print(""); from_string(l) -> elem(_)of(programs)

COMMENT
say and list choices

say(_)and_list_choices_from(_) : String x Strings => Program
  = (to_say, choices) => print("\n" + to_say) ; list_choices_from_list(choices)

list_choices_from_list(_) : Strings => Program
  = choices_from_list(_)to_string o> print(_)

choices_from_list(_)to_string : Strings => String
  = add_one_indexes_to(_) o>
    apply((i, s) => i + ". " + s + "  ")to_all_in(_) o>
    concat_lists(_) o> (_ + "(Enter to quit)" )

COMMENT
paths

todo_dir : Path
  = "/home/gnostis/.local/share/Todo/"

file_list : ListOf(Path)s
  = apply(todo_dir + _)to_all_in(file_names_in_dir)

file_names_in_dir : Strings
  = ["Next", "Schedule", "Waiting", "Projects", "Later"]

COMMENT
tasks from file

tasks_from_location(_) : Location => ProgramWith(Tasks)
  = (inds, p) =>
    apply(tasks_of_indexes(inds)from_string(_))inside(read_file(p))

tasks_from_file(_) : Path => ProgramWith(Tasks)
  = read_file(_) o> apply(tasks_from_string(_))inside(_)

tasks_of_indexes(_)from_string(_) : ListOf(Int)s x String => Tasks
  = (is, s) => tasks_from_string(s) -> tasks_of_indexes(is)from(_)

tasks_of_indexes(_)from(_) : ListOf(Int)s x Tasks => Tasks
  = (?, ts)
    [] => ts
    [i, is = ...] => tasks_of_indexes(is)from(elem(i)of(ts).subtasks)

tasks_from_string(_) : String => Tasks
  = split(_)to_lines o> tasks_from_lines(_)

tasks_from_lines(_) : Lines => Tasks
  = tasks_of_level(0)from_lines(_) o> ?
    (ts, []) => ts
    ... => error("Not all lines were put into tasks")

tasks_of_level(_)from_lines(_) : Int x Lines => Tasks x Lines
  = (lvl, ?)
    [] => ([],[])
    [l, ls = ...] =>
      task_of_level(lvl)from_lines(l, ls) -> ?
        a_value =>
          the_value -> (t, new_ls) =>
          tasks_of_level(lvl)from_lines(new_ls) -> (ts, ls) =>
          (t + ts, ls)
        no_value =>
          ([], l + ls)

task_of_level(_)from_lines(_,_) : Int x Line x Lines => Possibly(Task x Lines)
  = (lvl, l, ls) =>
    description_from(l)in_level(lvl) -> ?
      a_value =>
        tasks_of_level(lvl + 1)from_lines(ls) -> (sts, new_ls) =>
        a_value--((the_value, sts), new_ls)
      no_value =>
        no_value

description_from(_)in_level(_) : Line x Int => Possibly(String)
  = (l, i) =>
    drop(i)levels_of_indentation_from(l) -> ?
      a_value =>
        the_value -> ?
          ['-', ' ', s = ...] => a_value--s
          ... => no_value
      no_value => no_value

drop(_)levels_of_indentation_from(_) : Int x String => Possibly(String)
  = ?
    (0, s) => a_value--s
    (i, [' ', ' ', s = ...]) => drop(i - 1)levels_of_indentation_from(s)
    (i, s) => no_value

COMMENT
manipulating tasks

change_tasks_of_location(_)with(_) : Location x (Tasks => Tasks) => Program
  = ((tp, p), f(_)) =>
    tasks_from_file(p) >>
    change_tasks(_)at(tp)with(f(_)) o> write_tasks(_)to_file(p)

change_tasks_of(_)with(_) : Path x (Tasks => Tasks) => Program
  = (p, f(_)) => tasks_from_file(p) >> f(_) o> write_tasks(_)to_file(p)

change_tasks(_)at(_)with(_) : Tasks x TaskPath x (Tasks => Tasks) => Tasks
  = (ts, ?, f(_))
    [] => f(ts)
    [i, is = ...] =>
      split(ts)at_index(i-1) -> (before, [t1, after = ...]) =>
      before + new(t1) + after
      where
      new(_) : Task => Task
        = t1 => (t1.desc, change_tasks(t1.subtasks)at(is)with(f(_)))

COMMENT
adding tasks

add_str(_)as_task_to_location(_) : String x Location => Program
  = (s, l) => add_task(str(s)to_task)to_location(l)

str(_)to_task : String => Task
  = (_, [])

add_task(_)to_location(_) : Task x Location => Program
  = (t, (tp, p)) => change_tasks_of(p)with(add_task(t)to_tasks(_)at(tp))

add_task(_)to_file(_) : Task x Path => Program
  = (t, p) => append(task(t)to_string)to_file(p)

add_task(_)to_tasks(_)at(_) : Task x Tasks x TaskPath => Tasks
  = (t, ts, tp) => change_tasks(ts)at(tp)with(_ + t)

COMMENT
removing tasks

remove_task_at_index(_)in_location(_) : Int x Location => Program
  = (i, l) => change_tasks_of_location(l)with(remove_task_of_index(i - 1)from(_))

remove_task_at_index(_)in(_) : Int x Path => Program
  = (i, p) => change_tasks_of(p)with(remove_task_of_index(i - 1)from(_))

remove_task_of_index(_)from(_)at(_) : Int x Tasks x TaskPath => Tasks
  = (i, ts, tp) =>
    change_tasks(ts)at(tp)with(remove_task_of_index(i - 1)from(_))

remove_task_of_index(_)from(_) : Int x Tasks => Tasks
  = (i, ts) =>
    split(ts)at_index(i) -> (before, [*, after = ...]) => before + after

remove_and_get_task_of_index(_)from_tasks(_) : Int x Tasks => Tasks x Task
  = (i, ts) =>
    split(ts)at_index(i) -> (before, [t, after = ...]) => (before + after, t)

remove_and_get_task_of_index(_)from(_) : Int x Path => ProgramWith(Task)
  = (i, p) =>
    tasks_from_file(p) >> remove_and_get_task_of_index(i)from_tasks(_) o>
    (ts, t) => write_tasks(ts)to_file(p); wrap(t)

COMMENT
inspecting tasks

get_task_of_path(_)in_file(_) : TaskPath x Path => ProgramWith(Task)
  = (tp, p) =>
    apply(get_task_of_path(tp)in_tasks(_))inside(tasks_from_file(p))

get_task_of_path(_)in_tasks(_) : TaskPath x Tasks => Task
  = (?, ts)
    [i] => elem(i)of(ts)
    [i, j, rest = ...] =>
      get_task_of_path(j + rest)in_tasks(elem(i)of(ts).subtasks)

get_task_of_index(_)of(_) : Int x Path => ProgramWith(Task)
  = (i, p) => apply(elem(i)of(_))inside(tasks_from_file(p))

COMMENT
editing tasks

edit_task(_)with_new_desc(_)in_location(_) : Int x String x Location => Program
  = (i, s, l) =>
    change_tasks_of_location(l)with(_) <-
    edit_task(i - 1)with_new_desc(s)in_tasks(_)

edit_task(_)with_new_desc(_)in_tasks(_) : Int x String x Tasks => Tasks
  = (i, s, ts) =>
    split(ts)at_index(i) -> (before, [t, after = ...]) =>
      before + new_task + after
      where
      new_task : Task
        = (s, t.subtasks)

COMMENT
moving tasks

move_task(_)to(_)in_location(_) : Int x Int x Location => Program
  = (i, j, p) => change_tasks_of_location(p)with(move_task(i - 1)to(j - 1)in(_))

move_task(_)to(_)in(_) : Int x Int x Tasks => Tasks
  = (i, j, ts) =>
    split(ts)at_index(i) -> (before, [elem, after = ...]) =>
    insert(elem)at_index(j)in(before + after)

insert(_)at_index(_)in(_) : Task x Int x Tasks => Tasks
  = (t, ?, ?)
    (0, l) => t + l
    (i, []) => error("List not big enough to insert element")
    (i, [t1, ts = ...]) => t1 + insert(t)at_index(i - 1)in(ts)

COMMENT
writing tasks to file

write_tasks(_)to_file(_) : Tasks x Path => Program
  = (ts, p) => write(tasks(ts)to_string)to_file(p)

COMMENT
tasks to string

tasks(_)to_string : Tasks => String
  = tasks(_)with_indetation(0)to_string

tasks(_)with_indetation(_)to_string : Tasks x Int => String
  = (ts, i) =>
    apply(task(_)with_indetation(i)to_string)to_all_in(ts) ->
    concat_lists(_)

task(_)with_indetation(_)to_string : Task x Int => String
  = (t, i) =>
    i * 2 * ' ' + "- " + t.desc + "\n" +
    tasks(t.subtasks)with_indetation(i + 1)to_string

task(_)to_string : Task => String
  = task(_)with_indetation(0)to_string

COMMENT
printing tasks

print_tasks(_)with_indetation(_) : Tasks x Int => Program
  = (ts, i) => for_all_in(ts, print_task(_)with_indetation(i))

print_task(_)with_indetation(_) : Task x Int => Program
  = (t, i) =>
    print(i * 2 * ' ' + "- " + t.desc) ;
    print_tasks(t.subtasks)with_indetation(i + 1)

print_tasks(_) : Tasks => Program
  = ?
    [] => print("No tasks")
    ts => for_all_in(add_one_indexes_to(ts), (i, t) => print(i + ". " + t.desc))

print_two_levels_of_tasks(_) : Tasks => Program
  = ?
    [] => print("No tasks")
    ts =>
      for_all_in(add_one_indexes_to(ts), print_indexed_task(_)and_subtasks)
      where
      print_indexed_task(_)and_subtasks : Int x Task => Program
        = (i, t) =>
          print_indexed_task((i, t)) ;
          for_all_in(add_one_indexes_to(t.subtasks), print_indented_indexed(_))

      print_indexed_task(_) : Int x Task => Program
        = (i, t) => print(i + ". " + t.desc)

      print_indented_indexed(_) : Int x Task => Program
        = (i, t) => print("  " + i + ". " + t.desc)

COMMENT
action choices and programs

location_actions : Strings
  = ["Add", "Remove", "Inspect", "Edit", "Move"]

act_progs_for_location(_) : Location => Programs
  = l =>
    list_and_choose_after_all_in(add_and_remove) + inspect_task_in_location(l) +
    list_and_choose_after_all_in(edit_and_move)
    where
    add_and_remove : Programs
      = [add_task_to_location(l), remove_task_from_location(l)]

    edit_and_move : Programs
      = [edit_task_in_location(l), move_task_in_location(l)]

    list_and_choose_after_all_in(_) : Programs => Programs
      = apply(_ ; list_and_choose)to_all_in(_)

    list_and_choose : Program
      = print(""); list_and_choose_action_for_location(l); print("")

add_task_to_location(_) : Location => Program
  = l =>
    print("Describe the task")and_get_line >> add_str(_)as_task_to_location(l)

remove_task_from_location(_) : Location => Program
  = l =>
    user_int_choice_from_prompt("Remove task by number") >>
    remove_task_at_index(_)in_location(l)

inspect_task_in_location(_) : Location => Program
  = (tp, p) =>
    print("Choose action by number or \"b\" for back")and_get_line >> ?
      "b" => print(""); inspect_back_in_location((tp, p))
      l =>
        list_and_choose_action_for_location((tp + i, p))
        where
        i : Int
          = from_string(l)

inspect_back_in_location(_) : Location => Program
  = (?, p)
    [] =>
      print("Not possible to go back (hit beginning)\n") ;
      list_and_choose_action_for_location(([], p))
    [i, is = ...] => list_and_choose_action_for_location((is, p))

edit_task_in_location(_) : Location => Program
  = l =>
    user_task_choice >> i =>
    print("New description")and_get_line >>
    edit_task(i)with_new_desc(_)in_location(l)

move_task_in_location(_) : Location => Program
  = l =>
    user_task_choice >> i =>
    user_int_choice_from_prompt("Move to number") >> j =>
    move_task(i)to(j)in_location(l)

move_task_from(_) : Path => Program
  = p =>
    user_task_choice >> i =>
    say(to_say)and_list_choices_from(category_choices) ;
    choose_from(move_task_by_index(i)from(p)programs)
    where
    to_say : String
      = "Choose task category to move to by number"

move_task_by_index(_)from(_)programs : Int x Path => Programs
  = (i, p) => apply(move_task_by_index(i)from(p)to(_))to_all_in(file_list)

move_task_by_index(_)from(_)to(_) : Int x Path x Path => Program
  = (i, from_p, to_p) =>
    remove_and_get_task_of_index(i-1)from(from_p) >> add_task(_)to_file(to_p) ;
    choose_task_category

user_task_choice : ProgramWith(Int)
  = user_int_choice_from_prompt("Choose task by number")

user_int_choice_from_prompt(_) : String => ProgramWith(Int)
  = s => apply(from_string(_))inside(print(s)and_get_line)

COMMENT
category choices and programs

category_choices : Strings
  = file_names_in_dir

category_programs : Programs
  = apply(list_and_choose_action_for_file(_))to_all_in(file_list)

list_and_choose_action_for_location(_) : Location => Program
  = l => list_tasks_of_location(l) ; choose_action_for_location(l)

list_and_choose_action_for_file(_) : Path => Program
  = p => list_tasks_of_location(([], p)) ; choose_action_for_location(([], p))

list_tasks_of_location(_) : Location => Program
  = tasks_from_location(_) o> (_ >> print_two_levels_of_tasks(_))

choose_action_for_location(_) : Location => Program
  = l =>
    say("Choose action by number")and_list_choices_from(actions) ;
    choose_from(progs)
    where
    actions : Strings
      = location_actions + l -> ?
        ([], *) => ["Move elsewhere"]
        ... => []

    progs : Programs
      = act_progs_for_location(l) + l -> ?
        ([], p) => [move_task_from(p)]
        ... => []
